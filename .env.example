# COIN configuration — copy to .env and fill in. .env is git-ignored.

# ── API server ──
PORT=8787
APP_URL=http://localhost:8742
DATABASE_URL=postgres://coin:change-me@localhost:5433/coin
TEST_DATABASE_URL=postgres://coin:change-me@localhost:5433/coin_test
QA_DATABASE_URL=postgres://coin:change-me@localhost:5433/coin_qa
LOG_LEVEL=info
# one-click sign-in with the seeded demo accounts (turn off for real users)
DEMO_LOGIN=true
# password given to every seeded account by "npm run db:seed"
SEED_PASSWORD=coin@2026
# outbox = emails are stored in the database and shown in the app; smtp = also delivered through SMTP_URL
EMAIL_DRIVER=outbox
SMTP_URL=
EMAIL_FROM=COIN <coin@ambergroupindia.com>
SUPPLIER_PORTAL_URL=https://supplier-portal.coin.amber

# ── local PostgreSQL cluster (scripts/db.mjs) ──
PGPORT=5433
PG_BIN=C:/Program Files/PostgreSQL/18/bin

# ── web app (Vite) ──
# api = use the server above; local = browser-only demo (what Vercel runs)
VITE_DATA_MODE=api
VITE_API_PROXY=http://localhost:8787
